# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Gemini Developer API (not Vertex AI) -- used only by assurance/planner.py.
# Without it the planner fails closed and every item runs all four evaluators.
GOOGLE_API_KEY=your-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model used for planner triage.
MODEL=gemini-3.5-flash
